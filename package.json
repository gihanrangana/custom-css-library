{
  "name": "@your-github-username/feathercss",
  "version": "0.1.0",
  "description": "Lightweight simple pure CSS library built with SCSS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-github-username/custom-css-library.git"
  },
  "homepage": "https://github.com/your-github-username/custom-css-library#readme",
  "bugs": {
    "url": "https://github.com/your-github-username/custom-css-library/issues"
  },
  "files": [
    "dist",
    "src/scss",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/feather.css",
  "style": "dist/feather.css",
  "exports": {
    ".": "./dist/feather.css",
    "./scss": "./src/scss/feather.scss"
  },
  "scripts": {
    "build": "sass src/scss/feather.scss dist/feather.css && sass src/scss/feather.scss dist/feather.min.css --style=compressed",
    "demo:install": "npm --prefix demo install",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "prepack": "npm run build",
    "release:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "sass": "^1.77.8"
  }
}
